<resources>
    <style name="DarkAppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FFB783</item>
        <item name="android:colorControlActivated">#FFB783</item>
        <item name="android:colorControlNormal">#D2C1B1</item>
        <item name="android:textColorPrimary">#F4E9DD</item>
        <item name="android:textColorSecondary">#D2C1B1</item>
        <item name="android:colorBackground">#211D19</item>
        <item name="android:colorBackgroundFloating">#2D2722</item>
        <item name="android:windowBackground">#211D19</item>
        <item name="android:statusBarColor">#211D19</item>
        <item name="android:navigationBarColor">#211D19</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/DarkAppDialogTheme</item>
    </style>
    <style name="DarkAppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FFB783</item>
        <item name="android:colorControlActivated">#FFB783</item>
        <item name="android:colorControlNormal">#D2C1B1</item>
        <item name="android:textColorPrimary">#F4E9DD</item>
        <item name="android:textColorSecondary">#D2C1B1</item>
        <item name="android:colorBackground">#2D2722</item>
        <item name="android:colorBackgroundFloating">#2D2722</item>
        <item name="android:windowBackground">@drawable/dialog_background_dark</item>
        <item name="android:windowElevation">12dp</item>
        <item name="android:backgroundDimAmount">0.35</item>
    </style>
    <style name="CreamDarkAppTheme" parent="DarkAppTheme">
        <item name="android:colorAccent">#FFB783</item>
        <item name="android:colorControlActivated">#FFB783</item>
        <item name="android:colorControlNormal">#C3C3BF</item>
        <item name="android:colorControlHighlight">#33FFB783</item>
        <item name="android:textColorPrimary">#F2F2F1</item>
        <item name="android:textColorSecondary">#C3C3BF</item>
        <item name="android:colorBackground">#191919</item>
        <item name="android:colorBackgroundFloating">#222222</item>
        <item name="android:windowBackground">#191919</item>
        <item name="android:statusBarColor">#191919</item>
        <item name="android:navigationBarColor">#191919</item>
        <item name="android:alertDialogTheme">@style/CreamDarkAppDialogTheme</item>
    </style>
    <style name="CreamDarkAppDialogTheme" parent="DarkAppDialogTheme">
        <item name="android:colorAccent">#FFB783</item>
        <item name="android:colorControlActivated">#FFB783</item>
        <item name="android:colorControlNormal">#C3C3BF</item>
        <item name="android:colorControlHighlight">#33FFB783</item>
        <item name="android:textColorPrimary">#F2F2F1</item>
        <item name="android:textColorSecondary">#C3C3BF</item>
        <item name="android:colorBackground">#222222</item>
        <item name="android:colorBackgroundFloating">#222222</item>
        <item name="android:windowBackground">@drawable/cream_dialog_background_dark</item>
    </style>
</resources>

From 1d55d6ae3f26603d222da60263ffe0bad2cc2c42 Mon Sep 17 00:00:00 2001
From: QingYue Creation Task <creation-task@local>
Date: Thu, 24 Sep 2026 23:29:24 +0800
Subject: [PATCH 3/3] Disable activity transitions when system animations are
 off

---
 app/src/main/java/cn/qingyue/pdf/NoteMotion.java | 3 ++-
 tests/note-motion/NoteMotionTest.java            | 6 +++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/cn/qingyue/pdf/NoteMotion.java b/app/src/main/java/cn/qingyue/pdf/NoteMotion.java
index cdd313a..117cf42 100644
--- a/app/src/main/java/cn/qingyue/pdf/NoteMotion.java
+++ b/app/src/main/java/cn/qingyue/pdf/NoteMotion.java
@@ -47,7 +47,8 @@ public final class NoteMotion {
     }
 
     public static void applyActivityTransition(Activity activity, boolean entering) {
-        if (activity == null || !enabled(activity)) return;
+        if (activity == null) return;
+        if (!enabled(activity)) { activity.overridePendingTransition(0, 0); return; }
         int first = anim(activity, entering ? "note_enter" : "note_return_enter");
         int second = anim(activity, entering ? "note_exit" : "note_return_exit");
         if (first != 0 && second != 0) activity.overridePendingTransition(first, second);
diff --git a/tests/note-motion/NoteMotionTest.java b/tests/note-motion/NoteMotionTest.java
index c83ad31..0648dc7 100644
--- a/tests/note-motion/NoteMotionTest.java
+++ b/tests/note-motion/NoteMotionTest.java
@@ -22,12 +22,12 @@ public final class NoteMotionTest {
             NoteMotion.enter(disabled);
             check(disabled.alpha==1&&disabled.translationY==0&&disabled.animator.starts==0,"disabled scale restores view");
             NoteMotion.applyActivityTransition(activity,true);
-            check(activity.calls==0,"disabled scale skips activity transition");
+            check(activity.calls==axis+1&&activity.first==0&&activity.second==0,"disabled scale explicitly removes activity transition");
         }
         activity.resolver.animator=activity.resolver.transition=activity.resolver.window=1;
         NoteMotion.applyActivityTransition(activity,true);
-        check(activity.calls==1&&activity.first=="note_enter".hashCode()&&activity.second=="note_exit".hashCode(),"enter resources");
+        check(activity.calls==4&&activity.first=="note_enter".hashCode()&&activity.second=="note_exit".hashCode(),"enter resources");
         NoteMotion.applyActivityTransition(activity,false);
-        check(activity.calls==2&&activity.first=="note_return_enter".hashCode()&&activity.second=="note_return_exit".hashCode(),"return resources");
+        check(activity.calls==5&&activity.first=="note_return_enter".hashCode()&&activity.second=="note_return_exit".hashCode(),"return resources");
     }
 }
-- 

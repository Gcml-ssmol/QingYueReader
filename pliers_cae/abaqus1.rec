# -*- coding: mbcs -*-
from mesh import *
mdb.models['Model-1'].setValues(description=
    'Reference-size idealized long nose pliers; elastic Cr-V proxy; not a reverse-engineered product.')
mdb.models['Model-1'].Material(name='CrV_Elastic_Proxy')
mdb.models['Model-1'].materials['CrV_Elastic_Proxy'].Elastic(table=((210000.0, 
    0.3), ))
mdb.models['Model-1'].Material(name='Steel_Workpiece')
mdb.models['Model-1'].materials['Steel_Workpiece'].Elastic(table=((210000.0, 
    0.3), ))
mdb.models['Model-1'].HomogeneousSolidSection(material='CrV_Elastic_Proxy', 
    name='ToolSteel')
mdb.models['Model-1'].HomogeneousSolidSection(material='Steel_Workpiece', name=
    'BlockSteel')
mdb.models['Model-1'].ConstrainedSketch(name='LeverOutline', sheetSize=450.0)
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-5, 73), point2=(
    -8, 73))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-8, 73), point2=(
    -17, 30))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-17, 30), point2=(
    -18, 15))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-18, 15), point2=(
    -14, 8))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-14, 8), point2=(
    -13, -5))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-13, -5), point2=(
    -5, -15))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-5, -15), point2=(
    7, -22))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(7, -22), point2=(
    15, -55))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(15, -55), point2=(
    21, -95))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(21, -95), point2=(
    23, -127))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(23, -127), point2=(
    35, -127))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(35, -127), point2=(
    34, -95))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(34, -95), point2=(
    28, -55))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(28, -55), point2=(
    20, -22))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(20, -22), point2=(
    14, -10))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(14, -10), point2=(
    14, 5))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(14, 5), point2=(8, 
    15))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(8, 15), point2=(-5, 
    23))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-5, 23), point2=(
    -5, 73))
mdb.models['Model-1'].sketches['LeverOutline'].CircleByCenterPerimeter(center=(
    0.0, 0.0), point1=(3.0, 0.0))
mdb.models['Model-1'].Part(dimensionality=THREE_D, name='Lever', type=
    DEFORMABLE_BODY)
mdb.models['Model-1'].parts['Lever'].BaseSolidExtrude(depth=9.5, sketch=
    mdb.models['Model-1'].sketches['LeverOutline'])
mdb.models['Model-1'].parts['Lever'].DatumPlaneByPrincipalPlane(offset=9.5, 
    principalPlane=XYPLANE)
mdb.models['Model-1'].parts['Lever'].DatumAxisByPrincipalAxis(principalAxis=
    YAXIS)
mdb.models['Model-1'].ConstrainedSketch(name='HalfLapCut', sheetSize=450.0, 
    transform=mdb.models['Model-1'].parts['Lever'].MakeSketchTransform(
    sketchPlane=mdb.models['Model-1'].parts['Lever'].datums[2], 
    sketchPlaneSide=SIDE1, 
    sketchUpEdge=mdb.models['Model-1'].parts['Lever'].datums[3], 
    sketchOrientation=RIGHT, origin=(0.0, 0.0, 9.5)))
mdb.models['Model-1'].sketches['HalfLapCut'].rectangle(point1=(-60.0, -24.0), 
    point2=(60.0, 24.0))
mdb.models['Model-1'].parts['Lever'].CutExtrude(depth=4.75, 
    flipExtrudeDirection=OFF, sketch=
    mdb.models['Model-1'].sketches['HalfLapCut'], sketchOrientation=RIGHT, 
    sketchPlane=mdb.models['Model-1'].parts['Lever'].datums[2], 
    sketchPlaneSide=SIDE1, sketchUpEdge=
    mdb.models['Model-1'].parts['Lever'].datums[3])
mdb.models['Model-1'].parts['Lever'].SectionAssignment(region=Region(
    cells=mdb.models['Model-1'].parts['Lever'].cells.getSequenceFromMask(mask=(
    '[#1 ]', ), )), sectionName='ToolSteel')
mdb.models['Model-1'].parts['Lever'].Surface(name='Jaw', side1Faces=
    mdb.models['Model-1'].parts['Lever'].faces.getSequenceFromMask(mask=(
    '[#400000 ]', ), ))
mdb.models['Model-1'].parts['Lever'].Surface(name='Grip', side1Faces=
    mdb.models['Model-1'].parts['Lever'].faces.getSequenceFromMask(mask=(
    '[#8000 ]', ), ))
mdb.models['Model-1'].parts['Lever'].Surface(name='PinBore', side1Faces=
    mdb.models['Model-1'].parts['Lever'].faces.getSequenceFromMask(mask=(
    '[#800000 ]', ), ))
mdb.models['Model-1'].parts['Lever'].Set(cells=
    mdb.models['Model-1'].parts['Lever'].cells, name='ALL')
mdb.models['Model-1'].ConstrainedSketch(name='BlockOutline', sheetSize=100.0)
mdb.models['Model-1'].sketches['BlockOutline'].rectangle(point1=(-5.0, 58.0), 
    point2=(5.0, 68.0))
mdb.models['Model-1'].Part(dimensionality=THREE_D, name='Workpiece', type=
    DEFORMABLE_BODY)
mdb.models['Model-1'].parts['Workpiece'].BaseSolidExtrude(depth=9.5, sketch=
    mdb.models['Model-1'].sketches['BlockOutline'])
mdb.models['Model-1'].parts['Workpiece'].SectionAssignment(region=Region(
    cells=mdb.models['Model-1'].parts['Workpiece'].cells.getSequenceFromMask(
    mask=('[#1 ]', ), )), sectionName='BlockSteel')
mdb.models['Model-1'].parts['Workpiece'].Surface(name='Left', side1Faces=
    mdb.models['Model-1'].parts['Workpiece'].faces.getSequenceFromMask(mask=(
    '[#1 ]', ), ))
mdb.models['Model-1'].parts['Workpiece'].Surface(name='Right', side1Faces=
    mdb.models['Model-1'].parts['Workpiece'].faces.getSequenceFromMask(mask=(
    '[#4 ]', ), ))
mdb.models['Model-1'].parts['Workpiece'].DatumPlaneByPrincipalPlane(offset=0.0, 
    principalPlane=YZPLANE)
mdb.models['Model-1'].parts['Workpiece'].PartitionCellByDatumPlane(cells=
    mdb.models['Model-1'].parts['Workpiece'].cells, datumPlane=
    mdb.models['Model-1'].parts['Workpiece'].datums[5])
mdb.models['Model-1'].parts['Workpiece'].DatumPlaneByPrincipalPlane(offset=4.75
    , principalPlane=XYPLANE)
mdb.models['Model-1'].parts['Workpiece'].PartitionCellByDatumPlane(cells=
    mdb.models['Model-1'].parts['Workpiece'].cells, datumPlane=
    mdb.models['Model-1'].parts['Workpiece'].datums[7])
mdb.models['Model-1'].parts['Workpiece'].Set(faces=
    mdb.models['Model-1'].parts['Workpiece'].faces.getSequenceFromMask(mask=(
    '[#300 ]', ), ), name='MID_X')
mdb.models['Model-1'].parts['Workpiece'].Set(faces=
    mdb.models['Model-1'].parts['Workpiece'].faces.getSequenceFromMask(mask=(
    '[#3 ]', ), ), name='MID_Z')
mdb.models['Model-1'].parts['Workpiece'].Set(faces=
    mdb.models['Model-1'].parts['Workpiece'].faces.getSequenceFromMask(mask=(
    '[#22084 ]', ), ), name='BOTTOM')
mdb.models['Model-1'].rootAssembly.DatumCsysByDefault(CARTESIAN)
mdb.models['Model-1'].rootAssembly.Instance(dependent=ON, name='LEFT_JAW', 
    part=mdb.models['Model-1'].parts['Lever'])
mdb.models['Model-1'].rootAssembly.Instance(dependent=ON, name='RIGHT_JAW', 
    part=mdb.models['Model-1'].parts['Lever'])
mdb.models['Model-1'].rootAssembly.rotate(angle=180.0, axisDirection=(0.0, 1.0, 
    0.0), axisPoint=(0.0, 0.0, 0.0), instanceList=('RIGHT_JAW', ))
mdb.models['Model-1'].rootAssembly.translate(instanceList=('RIGHT_JAW', ), 
    vector=(0.0, 0.0, 9.5))
mdb.models['Model-1'].rootAssembly.Instance(dependent=ON, name='BLOCK', part=
    mdb.models['Model-1'].parts['Workpiece'])
mdb.models['Model-1'].rootAssembly.ReferencePoint(point=(0.0, 0.0, 2.375))
mdb.models['Model-1'].rootAssembly.Set(name='PIN_LEFT_JAW', referencePoints=(
    mdb.models['Model-1'].rootAssembly.referencePoints[8], ))

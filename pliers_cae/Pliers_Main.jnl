mdb.models['Model-1'].setValues(description=
    'Reference-size idealized long nose pliers; elastic Cr-V proxy; not a reverse-engineered product.')
mdb.models['Model-1'].Material(name='CrV_Elastic_Proxy')
mdb.models['Model-1'].materials['CrV_Elastic_Proxy'].Elastic(table=((210000.0, 
    0.3), ))
mdb.models['Model-1'].Material(name='Steel_Workpiece')
mdb.models['Model-1'].materials['Steel_Workpiece'].Elastic(table=((210000.0, 
    0.3), ))
mdb.models['Model-1'].HomogeneousSolidSection(material='CrV_Elastic_Proxy', 
    name='ToolSteel')
mdb.models['Model-1'].HomogeneousSolidSection(material='Steel_Workpiece', name=
    'BlockSteel')
mdb.models['Model-1'].ConstrainedSketch(name='LeverOutline', sheetSize=450.0)
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-5, 73), point2=(
    -8, 73))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-8, 73), point2=(
    -17, 30))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-17, 30), point2=(
    -18, 15))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-18, 15), point2=(
    -14, 8))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-14, 8), point2=(
    -13, -5))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-13, -5), point2=(
    -5, -15))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(-5, -15), point2=(
    7, -22))
mdb.models['Model-1'].sketches['LeverOutline'].Line(point1=(7, -22), point2=(
